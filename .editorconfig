# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break; keep them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[LICENSE]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
